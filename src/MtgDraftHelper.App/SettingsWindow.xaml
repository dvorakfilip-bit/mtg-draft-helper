<Window x:Class="MtgDraftHelper.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Settings.Title}" Icon="Resources/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource HeaderBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,6,16,14">
        <!-- Data 17Lands -->
        <TextBlock Text="{StaticResource Settings.Data}" Style="{StaticResource Group}" />
        <DockPanel>
            <TextBlock Text="{StaticResource Settings.Group}" VerticalAlignment="Center" Width="140" />
            <ComboBox x:Name="GroupBox">
                <ComboBoxItem Content="{StaticResource Settings.GroupAll}" />
                <ComboBoxItem Content="{StaticResource Settings.GroupTop}" />
            </ComboBox>
        </DockPanel>
        <TextBlock x:Name="DataInfoText" Style="{StaticResource MutedText}" Margin="0,6,0,2" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="RefreshButton" Content="{StaticResource Settings.Refresh}" Padding="10,3" Click="Refresh_Click" />
        </StackPanel>
        <TextBlock x:Name="RefreshStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- Váhy -->
        <TextBlock Text="{StaticResource Settings.Weights}" Style="{StaticResource Group}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <TextBlock Text="{StaticResource Settings.OffColor}" VerticalAlignment="Center" />
            <Slider x:Name="OffColorSlider" Grid.Column="1" Minimum="0" Maximum="60" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OffColorSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{StaticResource Settings.Archetype}" VerticalAlignment="Center" />
            <Slider x:Name="ArchetypeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="15" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ArchetypeSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{StaticResource Settings.Signal}" VerticalAlignment="Center" />
            <Slider x:Name="SignalSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="15" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=SignalSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Button Content="{StaticResource Settings.ResetWeights}" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0" Click="ResetWeights_Click" />

        <!-- Zobrazení -->
        <TextBlock Text="{StaticResource Settings.Columns}" Style="{StaticResource Group}" />
        <CheckBox x:Name="ShowGihBox" Content="{StaticResource Settings.ShowGih}" />
        <CheckBox x:Name="ShowAlsaBox" Content="{StaticResource Settings.ShowAlsa}" />
        <CheckBox x:Name="ShowReasonsBox" Content="{StaticResource Settings.ShowReasons}" />
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="{StaticResource Settings.Opacity}" VerticalAlignment="Center" Width="140" />
            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0} %}" />
            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" ValueChanged="Opacity_ValueChanged" />
        </DockPanel>

        <!-- Zkratky -->
        <TextBlock Text="{StaticResource Settings.Hotkeys}" Style="{StaticResource Group}" TextWrapping="Wrap" />
        <DockPanel Margin="0,2">
            <TextBlock Text="{StaticResource Settings.ToggleHotkey}" VerticalAlignment="Center" Width="190" />
            <TextBox x:Name="ToggleHotkeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Padding="3,2" />
        </DockPanel>
        <DockPanel Margin="0,2">
            <TextBlock Text="{StaticResource Settings.ClickThroughHotkey}" VerticalAlignment="Center" Width="190" />
            <TextBox x:Name="ClickThroughHotkeyBox" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Padding="3,2" />
        </DockPanel>
        <TextBlock x:Name="HotkeyError" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />

        <!-- Log -->
        <TextBlock Text="{StaticResource Settings.Log}" Style="{StaticResource Group}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{StaticResource Settings.Browse}" Padding="8,2" Margin="4,0,0,0" Click="Browse_Click" />
            <Button DockPanel.Dock="Right" Content="{StaticResource Settings.LogDefault}" Padding="8,2" Margin="4,0,0,0" Click="DefaultLog_Click" />
            <TextBox x:Name="LogPathBox" Padding="3,2" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{StaticResource Settings.Save}" IsDefault="True" Padding="16,4" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="{StaticResource Settings.Cancel}" IsCancel="True" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</Window>
