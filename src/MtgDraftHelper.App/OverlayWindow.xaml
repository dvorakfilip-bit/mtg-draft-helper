<Window x:Class="MtgDraftHelper.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MtgDraftHelper.App.ViewModels"
        Title="{StaticResource App.Title}"
        Width="390" Height="760" MinWidth="300" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
            <!-- Záhlaví: tažením se okno přesouvá -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="10,4,4,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource HeaderButton}" Content="–" ToolTip="{StaticResource Button.Minimize}" Click="Minimize_Click" />
                        <Button Style="{StaticResource HeaderButton}" Content="✕" ToolTip="{StaticResource Button.Close}" Click="Close_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{StaticResource App.Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EventTitle}" Style="{StaticResource MutedText}"
                                   Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Patička: zdroj dat (podmínka 17Lands – viditelně uvést zdroj) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://www.17lands.com/public_datasets" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding DataInfo, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </Border>

            <!-- Stavová zpráva (čekání, stahování dat, varování) -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="10,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TabControl SelectedIndex="{Binding SelectedTab}" Margin="6,0"
                        Visibility="{Binding IsDraftActive, Converter={StaticResource BoolToVisibility}}">
                <!-- Draft -->
                <TabItem Header="{StaticResource Tab.Draft}">
                    <DockPanel Margin="4,4,4,0">
                        <!-- Přehled poolu -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding PickInfo}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding PoolInfo}" Style="{StaticResource MutedText}" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{StaticResource Header.Colors}" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding ColorBars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ColorBar}">
                                                    <StackPanel Margin="0,0,4,0" Width="14">
                                                        <Border Height="30" VerticalAlignment="Bottom" Background="#22FFFFFF">
                                                            <Border VerticalAlignment="Bottom" Background="{Binding Brush}"
                                                                    Height="{Binding Fraction, Converter={x:Static vm:Converters.FractionToHeight30}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Letter}" HorizontalAlignment="Center" FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{StaticResource Header.Curve}" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding Curve}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CurveBar}">
                                                    <StackPanel Margin="0,0,3,0" Width="14" ToolTip="{Binding Count}">
                                                        <Border Height="30" VerticalAlignment="Bottom">
                                                            <Border VerticalAlignment="Bottom" Background="{StaticResource MutedBrush}" Height="{Binding Height}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{StaticResource Header.Signals}" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding SignalBars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ColorBar}">
                                                    <StackPanel Margin="0,0,4,0" Width="14">
                                                        <Border Height="30" VerticalAlignment="Bottom" Background="#22FFFFFF">
                                                            <Border VerticalAlignment="Bottom" Background="{Binding Brush}"
                                                                    Height="{Binding Fraction, Converter={x:Static vm:Converters.FractionToHeight30}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Letter}" HorizontalAlignment="Center" FontSize="10" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Hlavička tabulky -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Header.Score}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Column="1" Text="{StaticResource Header.Card}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Column="2" Text="{StaticResource Header.Gih}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{StaticResource Header.Alsa}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Right" />
                        </Grid>

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding PackCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CardRow}">
                                        <Border CornerRadius="3" Padding="0,3" Margin="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TopRowBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding ScoreBrush}" CornerRadius="3" Width="32" Height="20" VerticalAlignment="Top" Margin="2,0,0,0">
                                                    <TextBlock Text="{Binding Score}" Foreground="#FF101010" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="4,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ColorBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="13,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding GihWr}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding Alsa}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Pool -->
                <TabItem Header="{StaticResource Tab.Pool}">
                    <ScrollViewer Margin="4">
                        <ItemsControl ItemsSource="{Binding PoolGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PoolGroup}">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CardRow}">
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="52" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{Binding ScoreBrush}" CornerRadius="3" Width="28" Height="17">
                                                            <TextBlock Text="{Binding Score}" Foreground="#FF101010" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ManaCost}" Style="{StaticResource MutedText}" Margin="4,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding GihWr}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!-- Balíček (M4) -->
                <TabItem Header="{StaticResource Tab.Deck}">
                    <TextBlock Text="{StaticResource Deck.Placeholder}" Style="{StaticResource MutedText}" Margin="8" TextWrapping="Wrap" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
